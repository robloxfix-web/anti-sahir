<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0a1a"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌙"
            android:textSize="52sp"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="مكافح السهر"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#a78bfa"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="طريقك الذكي نحو النوم الصحي الساعة 10:30 مساءً"
            android:textSize="13sp"
            android:textColor="#94a3b8"
            android:layout_marginTop="6dp"
            android:gravity="center"/>

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:layout_marginTop="24dp"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏰ اضبط وقت نومك الحالي للبدء"
                android:textColor="#94a3b8"
                android:textSize="14sp"
                android:layout_gravity="center"/>

            <TextView
                android:id="@+id/tvToday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textSize="42sp"
                android:textStyle="bold"
                android:textColor="#a78bfa"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="الهدف: 10:30 م"
                    android:textColor="#64748b"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvDaysLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="#a78bfa"
                    android:textSize="12sp"/>

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:progress="0"
                android:progressTint="#7c3aed"
                android:max="100"/>

            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#64748b"
                android:textSize="11sp"
                android:layout_gravity="center"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <!-- Time Picker -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:layout_marginTop="16dp"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="متى تنام الآن عادةً؟"
                android:textColor="#c4b5fd"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_gravity="center"/>

            <TimePicker
                android:id="@+id/timePicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"/>

        </LinearLayout>

        <!-- Buttons -->
        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="✅ ابدأ الرحلة"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:backgroundTint="#7c3aed"
            android:layout_marginTop="16dp"/>

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🔄 إعادة الضبط"
            android:textSize="15sp"
            android:textColor="#94a3b8"
            android:backgroundTint="#1e293b"
            android:layout_marginTop="10dp"/>

        <!-- Info -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="كل يوم يتقدم وقت الإغلاق 15 دقيقة تلقائياً حتى تصل إلى 10:30 مساءً 🌙"
            android:textColor="#475569"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
